{
  "name": "xroad-securityserver-admin-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev-ss0": "vite --host --mode ss0",
    "dev-ss1": "vite --host --mode ss1",
    "dev-ss2": "vite --host --mode ss2",
    "build": "pnpm run generate-types && pnpm run generate-msw-types && pnpm run type-check && vite build",
    "preview": "vite preview",
    "build-only": "vite build",
    "test": "pnpm run generate-msw-types && pnpm run type-check && vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "lint": "eslint . --fix",
    "generate-types": "rm -rf src/openapi-types && openapi-ts",
    "generate-msw-types": "openapi-typescript ../../openapi-model/src/main/resources/META-INF/openapi-definition.yaml -o src/openapi-msw-paths.d.ts",
    "license-check": "license-check-and-add check -f ../../../shared-ui/license-check-and-add-config.json",
    "license-add": "license-check-and-add add -f ../../../shared-ui/license-check-and-add-config.json"
  },
  "dependencies": {
    "@niis/shared-ui": "workspace:*",
    "echarts": "^6.1.0",
    "maska": "^3.2.0",
    "vue-echarts": "^8.0.1"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@typescript-eslint/eslint-plugin": "~8.62.1",
    "@typescript-eslint/parser": "~8.62.1",
    "@vitest/ui": "4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint-plugin-vue-scoped-css": "^3.1.1",
    "resize-observer-polyfill": "^1.5.1"
  },
  "engines": {
    "npm": "use-pnpm",
    "yarn": "use-pnpm",
    "node": ">=22 <=24",
    "pnpm": ">=10"
  }
}
