<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
    logicalFilePath="serverconf/011-identifier-unique-constraint-and-column-cleanup.xml">

    <!-- object_type CHECK -->
    <changeSet author="niis" id="011-identifier-unique-constraint-and-column-fixes-001">
        <sql>
            ALTER TABLE identifier
                ADD CONSTRAINT identifier_object_type_check
                    CHECK (object_type IN ('MEMBER', 'SUBSYSTEM', 'GLOBALGROUP', 'LOCALGROUP'));
        </sql>
    </changeSet>

    <!-- Partial UNIQUE index -->
    <changeSet author="niis" id="011-identifier-unique-constraint-and-column-fixes-002">
        <sql>
            CREATE UNIQUE INDEX identifier_unique_object_index
                ON identifier (
                               object_type,
                               xroad_instance,
                               member_class,
                               member_code,
                               subsystem_code,
                               group_code,
                               server_code
                    )
                NULLS NOT DISTINCT
                WHERE object_type IN ('MEMBER', 'SUBSYSTEM', 'GLOBALGROUP');
        </sql>
    </changeSet>

    <!-- NOT NULL constraint -->
    <changeSet author="niis" id="011-identifier-unique-constraint-and-column-fixes-003">
        <addNotNullConstraint tableName="identifier" columnName="object_type"/>
    </changeSet>

    <!-- Drop columns -->
    <changeSet author="niis" id="011-identifier-unique-constraint-and-column-fixes-004">
        <dropColumn tableName="identifier" columnName="service_code"/>
        <dropColumn tableName="identifier" columnName="service_version"/>
    </changeSet>

</databaseChangeLog>
