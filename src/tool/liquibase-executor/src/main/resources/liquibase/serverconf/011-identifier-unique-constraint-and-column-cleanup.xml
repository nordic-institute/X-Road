<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.19.xsd"
    logicalFilePath="serverconf/011-identifier-unique-constraint-and-column-cleanup.xml">

    <changeSet author="niis" id="011-identifier-unique-constraint-and-column-cleanup-001">
        <sql><![CDATA[
            ALTER TABLE identifier
                ADD CONSTRAINT identifier_unique_object_key
                    UNIQUE NULLS NOT DISTINCT (
                object_type,
                xroad_instance,
                member_class,
                member_code,
                subsystem_code,
                group_code,
                server_code
                );
            ]]></sql>
    </changeSet>

    <changeSet author="niis" id="011-identifier-unique-constraint-and-column-cleanup-002">
        <dropColumn tableName="identifier" columnName="service_code"/>
        <dropColumn tableName="identifier" columnName="service_version"/>
    </changeSet>

</databaseChangeLog>
