<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.3.xsd"
    logicalFilePath="messagelog/12-timestamping-status.xml">
    <!--
        Single-row table holding the primary node's batch time-stamping failure: when the
        current failure started. Every node reads it to decide whether the cluster's
        time-stamping is healthy. The row exists only while batch time-stamping fails: the
        primary inserts it on a failed batch result and deletes it on a successful one.
    -->
    <changeSet author="niis" id="12-timestamping-status">
        <createTable tableName="timestamping_status">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="failed_since" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
