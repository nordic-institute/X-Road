<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.19.xsd"
    logicalFilePath="centerui/202608101200-ds-tls-cas.xml">

    <changeSet author="niis" id="202608101200-ds-tls-cas">
        <createTable tableName="ds_tls_cas">
            <column autoIncrement="true" name="id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="ds_tls_cas_pkey"/>
            </column>
            <column name="name" type="VARCHAR(255)"/>
            <column name="top_ca_id" type="INT"/>
            <column name="acme_server_directory_url" type="VARCHAR(255)"/>
            <column name="ds_tls_certificate_profile_id" type="VARCHAR(255)"/>
            <column name="created_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="ds_tls_ca_infos">
            <column autoIncrement="true" name="id" type="SERIAL">
                <constraints primaryKey="true" primaryKeyName="ds_tls_ca_infos_pkey"/>
            </column>
            <column name="cert" type="BYTEA"/>
            <column name="intermediate_ca_id" type="INT"/>
            <column name="valid_from" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
            <column name="valid_to" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="index_ds_tls_cas_on_top_ca_id" tableName="ds_tls_cas">
            <column name="top_ca_id"/>
        </createIndex>
        <createIndex indexName="index_ds_tls_ca_infos_on_intermediate_ca_id" tableName="ds_tls_ca_infos">
            <column name="intermediate_ca_id"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="top_ca_id" baseTableName="ds_tls_cas" constraintName="ds_tls_cas_top_ca_id_fk" deferrable="false" initiallyDeferred="false" onDelete="CASCADE" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="ds_tls_ca_infos"/>
        <addForeignKeyConstraint baseColumnNames="intermediate_ca_id" baseTableName="ds_tls_ca_infos" constraintName="ds_tls_ca_infos_intermediate_ca_id_fk" deferrable="false" initiallyDeferred="false" onDelete="CASCADE" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="ds_tls_cas"/>

        <sql splitStatements="false">
            <![CDATA[
            DROP TRIGGER IF EXISTS update_history ON ds_tls_cas;
            CREATE TRIGGER update_history AFTER INSERT OR UPDATE OR DELETE ON ds_tls_cas
                FOR EACH ROW EXECUTE PROCEDURE add_history_rows();

            DROP TRIGGER IF EXISTS update_history ON ds_tls_ca_infos;
            CREATE TRIGGER update_history AFTER INSERT OR UPDATE OR DELETE ON ds_tls_ca_infos
                FOR EACH ROW EXECUTE PROCEDURE add_history_rows();
            ]]>
        </sql>

        <rollback>
            <dropTable tableName="ds_tls_ca_infos" cascadeConstraints="true"/>
            <dropTable tableName="ds_tls_cas" cascadeConstraints="true"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
