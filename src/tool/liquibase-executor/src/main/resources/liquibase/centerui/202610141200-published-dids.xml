<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.19.xsd"
                   logicalFilePath="centerui/202610141200-published-dids.xml">

    <changeSet author="niis" id="202610141200-published-dids">
        <comment>Values a Security Server publishes: SYSTEM DID and DSP base URL on the server row, one DID per member in member_dids.</comment>

        <addColumn tableName="security_servers">
            <column name="system_did" type="VARCHAR(4000)">
                <constraints unique="true" uniqueConstraintName="security_servers_system_did_key"/>
            </column>
            <column name="dsp_base_url" type="TEXT"/>
        </addColumn>

        <sql>
            ALTER TABLE security_servers ADD CONSTRAINT security_servers_system_values_check
                CHECK ((system_did IS NULL) = (dsp_base_url IS NULL));
        </sql>

        <createTable tableName="member_dids">
            <column name="id" autoIncrement="true" type="SERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="security_server_id" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="did" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="security_server_id" baseTableName="member_dids"
                                 constraintName="member_dids_security_server_id_fk" deferrable="false" initiallyDeferred="false"
                                 onDelete="CASCADE" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="security_servers"/>

        <addForeignKeyConstraint baseColumnNames="member_id" baseTableName="member_dids"
                                 constraintName="member_dids_member_id_fk" deferrable="false" initiallyDeferred="false"
                                 onDelete="CASCADE" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="security_server_clients"/>

        <addUniqueConstraint tableName="member_dids" columnNames="security_server_id,member_id"
                             constraintName="member_dids_security_server_id_member_id_key"/>

        <createIndex indexName="index_member_dids_on_member_id" tableName="member_dids">
            <column name="member_id"/>
        </createIndex>

        <sql>
            ALTER TABLE member_dids ADD CONSTRAINT member_dids_did_excl EXCLUDE USING hash (did WITH =);
        </sql>

        <sql splitStatements="false">
            <![CDATA[
            DROP TRIGGER IF EXISTS update_history ON member_dids;
            CREATE TRIGGER update_history AFTER INSERT OR UPDATE OR DELETE ON member_dids
                FOR EACH ROW EXECUTE PROCEDURE add_history_rows();
            ]]>
        </sql>
    </changeSet>

</databaseChangeLog>
