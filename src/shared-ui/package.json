{
  "name": "@niis/shared-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json --composite false",
    "build": "pnpm run generate-types",
    "generate-types": "rm -rf src/openapi-types && openapi-ts",
    "license-check": "license-check-and-add check -f license-check-and-add-config.json",
    "license-add": "license-check-and-add add -f license-check-and-add-config.json",
    "cleanup": "rm -rf dist && rm -rf node_modules",
    "format": "prettier .  --write"
  },
  "main": "./src/index.ts",
  "dependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@fontsource-variable/material-symbols-rounded": "^5.3.2",
    "@vee-validate/i18n": "~4.15.1",
    "@vee-validate/rules": "~4.15.1",
    "axios": "~1.19.0",
    "dayjs": "^1.11.21",
    "deepmerge": "^4.3.1",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-msw": "^2.0.0"
  },
  "engines": {
    "npm": "use-pnpm",
    "yarn": "use-pnpm",
    "node": ">=22 <=24",
    "pnpm": ">=10"
  }
}
