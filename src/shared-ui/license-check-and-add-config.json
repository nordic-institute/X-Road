{
  "ignore": [
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "build/",
    "build.gradle",
    ".gradle",
    "gradle.lockfile",
    "settings-gradle.lockfile",
    "**/*.md",
    "**/*.svg",
    "**/*.eot",
    "**/*.ttf",
    "**/*.xml",
    "**/*.woff",
    "**/*.woff2",
    "**/*.DS_Store",
    "**/*.config.js",
    "**/*.cer",
    "**/*.log",
    "**/.*",
    "src/openapi-types/",
    "src/mock-openapi-types/",
    "**/openapi-types.ts",
    "**/openapi-msw-paths.d.ts",
    "scripts/dtsgen-wrapper.js",
    "tests/unit/__snapshots__",
    "build.gradle.kts",
    "build/**",
    ".gradle/**",
    ".settings/**"
  ],
  "license": "LICENSE.txt",
  "licenseFormats": {
    "ts|js|css|scss": {
      "prepend": "/*",
      "append": " */",
      "eachLine": {
        "prepend": " * "
      }
    },
    "vue": {
      "prepend": "<!--",
      "append": " -->",
      "eachLine": {
        "prepend": "   "
      }
    }
  },
  "trailingWhitespace": "TRIM"
}
