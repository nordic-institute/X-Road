{
  "name": "@niis/workspace-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev-cs": "pnpm run --filter xroad-centralserver-admin-ui dev",
    "dev-ss": "pnpm run --filter xroad-securityserver-admin-ui dev",
    "test-ss": "pnpm run --filter xroad-securityserver-admin-ui test",
    "build-workspace": "pnpm -r run build",
    "prepReportDirs": "mkdirp ./build && mkdirp ./build/reports",
    "npx-check-audit": "pnpm run prepReportDirs && pnpm dlx audit-ci@^7 --config shared-ui/audit-ci-shared.json --registry https://registry.npmjs.org >build/reports/ui-audit-ci.json"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^3.2.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.32.0",
    "eslint-plugin-vuetify": "^2.5.1",
    "happy-dom": "^20.8.9",
    "license-check-and-add": "~4.0.5",
    "mkdirp": "^3.0.1",
    "openapi-typescript-codegen": "^0.29.0",
    "path": "^0.12.7",
    "prettier": "^3.4.2",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.83.0",
    "typescript": "~5.7.2",
    "vite": "^6.4.2",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.3",
    "vue-i18n": "^10.0.8",
    "vue-tsc": "^2.1.10"
  },
  "pnpm": {
    "minimumReleaseAge": 4320,
    "overrides": {
      "axios": "~1.13.5",
      "cross-spawn": "7.0.5",
      "defu": "6.1.5",
      "flatted": "^3.4.2",
      "glob": "^10.5.0",
      "handlebars": "^4.7.9",
      "immutable": "5.1.5",
      "lodash": "4.18.0",
      "minimatch": "^10.2.3",
      "picomatch": "^4.0.4",
      "rollup": "^4.59.0",
      "semver": "^7.5.3",
      "tar": ">=7.5.10"
    }
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "npm": "use-pnpm",
    "yarn": "use-pnpm",
    "node": ">=18 <=20",
    "pnpm": ">=10"
  }
}
