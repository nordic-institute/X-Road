{
  "name": "@niis/workspace-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev-cs": "pnpm run --filter xroad-centralserver-admin-ui dev",
    "dev-ss": "pnpm run --filter xroad-securityserver-admin-ui dev",
    "test-ss": "pnpm run --filter xroad-securityserver-admin-ui test",
    "build-workspace": "pnpm -r run build",
    "prepReportDirs": "mkdirp ./build && mkdirp ./build/reports",
    "npx-check-audit": "pnpm run prepReportDirs && pnpm dlx audit-ci@^7 --config shared-ui/audit-ci-shared.json --registry https://registry.npmjs.org >build/reports/audit-ci.txt"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^10.2.3",
      "rollup": "^4.59.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.1.1",
    "@rushstack/eslint-patch": "^1.15.0",
    "@types/node": "^25.2.2",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuetify": "^2.5.3",
    "globals": "^16.5.0",
    "happy-dom": "^20.5.3",
    "license-check-and-add": "~4.0.5",
    "mkdirp": "^3.0.1",
    "openapi-typescript-codegen": "^0.30.0",
    "path": "^0.12.7",
    "prettier": "^3.8.1",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.97.3",
    "sass-loader": "^16.0.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.3.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.4.0",
    "vue-i18n": "^11.2.8",
    "vue-tsc": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.3+sha512.c961d1e0a2d8e354ecaa5166b822516668b7f44cb5bd95122d590dd81922f606f5473b6d23ec4a5be05e7fcd18e8488d47d978bbe981872f1145d06e9a740017",
  "engines": {
    "npm": "use-pnpm",
    "yarn": "use-pnpm",
    "node": ">=22 <=24",
    "pnpm": ">=10"
  }
}
