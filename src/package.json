{
  "name": "@niis/workspace-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev-cs": "pnpm run --filter xroad-centralserver-admin-ui dev",
    "dev-ss": "pnpm run --filter xroad-securityserver-admin-ui dev",
    "test-ss": "pnpm run --filter xroad-securityserver-admin-ui test",
    "build-workspace": "pnpm -r run build",
    "prepReportDirs": "mkdirp ./build && mkdirp ./build/reports",
    "npx-check-audit": "pnpm run prepReportDirs && pnpm dlx audit-ci@^7 --config shared-ui/audit-ci-shared.json --registry https://registry.npmjs.org >build/reports/ui-audit-ci.json"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.0.1",
    "@rushstack/eslint-patch": "^1.12.0",
    "@tsconfig/node18": "^18.2.4",
    "@types/node": "^22.15.30",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-vue": "^10.3.0",
    "eslint-plugin-vuetify": "^2.5.2",
    "happy-dom": "^20.8.9",
    "license-check-and-add": "~4.0.5",
    "mkdirp": "^3.0.1",
    "openapi-typescript-codegen": "^0.29.0",
    "path": "^0.12.7",
    "prettier": "^3.6.2",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.89.2",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-vuetify": "^2.1.1",
    "vitest": "^3.2.6",
    "vue-eslint-parser": "^10.2.0",
    "vue-i18n": "^11.1.9",
    "vue-tsc": "^2.2.10"
  },
  "pnpm": {
    "minimumReleaseAge": 4320,
    "overrides": {
      "@apidevtools/json-schema-ref-parser>js-yaml": "^4.3.1",
      "@apidevtools/swagger-cli>js-yaml": "^3.15.1",
      "@intlify/eslint-plugin-vue-i18n>js-yaml": "^4.3.1",
      "@isaacs/brace-expansion": ">=5.0.1",
      "axios": "^1.18.0",
      "brace-expansion": "^5.0.9",
      "cross-spawn": "7.0.5",
      "defu": "6.1.5",
      "fast-uri": "^3.1.5",
      "flatted": "^3.4.0",
      "form-data": "4.0.6",
      "handlebars": "4.7.9",
      "js-cookie": "3.0.7",
      "immutable": "^5.1.8",
      "lodash": "4.18.0",
      "minimatch": "^10.2.3",
      "nanoid": "^3.3.18",
      "picomatch": "4.0.4",
      "postcss": "^8.5.18",
      "rollup": "^4.59.0",
      "semver": "^7.5.3",
      "ws": "8.21.0"
    }
  },
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "npm": "use-pnpm",
    "yarn": "use-pnpm",
    "node": ">=18 <=20",
    "pnpm": ">=10"
  }
}
