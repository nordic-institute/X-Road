XROAD_UPGRADE_UNATTENDED=true
XROAD_UPGRADE_CONFIRMED=yes
XROAD_MIGRATION_UNATTENDED=true
XROAD_MIGRATION_CLI_URL=https://artifactory.niis.org/xroad-scripts/0.0.1-beta/migration-cli.jar
XROAD_REPO_BASE_URL=https://artifactory.niis.org
XROAD_REPO_MAIN=
XROAD_REPO_GPG_KEY_URL=
# Optional: override the full repo URL
XROAD_REPO_URL_OVERRIDE=
OPENBAO_MIRROR=
OPENBAO_MIRROR_USER=
XROAD_SS_PACKAGE=xroad-securityserver
XROAD_DELETE_OBSOLETE_FILES=

# DID port and DSP port, 1024-65535, different from each other. Stored before the services start.
# A port that is not set uses the default (7183 and 8183); a port that is already stored is kept.
#XROAD_DID_PORT=7183
#XROAD_DSP_PORT=8183
