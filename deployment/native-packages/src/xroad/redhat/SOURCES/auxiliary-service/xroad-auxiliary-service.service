[Unit]
Description=X-Road auxiliary service
After=network.target xroad-base.service
Requires=xroad-base.service

[Service]
User=xroad
Group=xroad
Type=notify
NotifyAccess=all
ExecStart=/usr/share/xroad/bin/xroad-auxiliary-service
Restart=on-failure
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target

