#!/bin/bash
. /usr/share/debconf/confmodule

if [ "$1" = "configure" ] || [ "$1" = "reconfigure" ]; then
  HOST=$(hostname -f)
  if (( ${#HOST} > 64 )); then
    HOST="$(hostname -s)"
  fi
  LIST=
  for i in $(ip addr | grep 'scope global' | tr '/' ' ' | awk '{print $2}'); do LIST+="IP:$i,"; done;
  ALT="${LIST}DNS:$(hostname -f),DNS:$(hostname -s)"

  db_subst xroad-common/service-subject HOST "$HOST"
  db_subst xroad-common/service-altsubject ALT "$ALT"

  db_get xroad-common/service-subject
  [ -z "$RET" ] && db_set xroad-common/service-subject "$HOST"

  db_get xroad-common/service-altsubject
  [ -z "$RET" ] && db_set xroad-common/service-altsubject "$ALT"

  db_beginblock
  db_input critical xroad-common/service-subject || true
  db_input critical xroad-common/service-altsubject || true
  db_endblock
  db_go
fi

# xroad-base is not unpacked yet when this script first runs, so normalize_port, ports_differ and
# dsp_port_rows_skip_reason of dsp_ports.sh are copied here and must stay identical to it. node_type
# differs on purpose: it reads with awk because crudini is not installed yet. The postinst checks the
# answers again.

# Prints the port number without leading zeros (08183 is 8183).
# Accepts digits only, in the range 1024-65535. Returns 1 and prints nothing otherwise.
# Arguments: $1 - port value
normalize_port() {
  local value="$1"
  [[ "$value" =~ ^[0-9]+$ ]] || return 1
  value="${value#"${value%%[!0]*}"}"
  [[ -n "$value" && ${#value} -le 5 ]] || return 1
  (( value >= 1024 && value <= 65535 )) || return 1
  printf '%s\n' "$value"
}

# Returns 0 when both values are valid ports and they are different numbers.
# Arguments: $1 - DID port, $2 - DSP port
ports_differ() {
  local did dsp
  did=$(normalize_port "$1") || return 1
  dsp=$(normalize_port "$2") || return 1
  [[ "$did" != "$dsp" ]]
}

# Prints the [node] type of /etc/xroad/conf.d/node.ini (for example primary or secondary).
# Prints nothing when the file is missing or unreadable, or has no [node] type. Always returns 0.
# Reads with awk: crudini is not installed yet when xroad-proxy.config first runs.
node_type() {
  local node_ini=/etc/xroad/conf.d/node.ini
  [[ -r "$node_ini" ]] || return 0
  awk -F= '
    /^[[:space:]]*\[/ { in_node = ($0 ~ /^[[:space:]]*\[[[:space:]]*node[[:space:]]*\]/); next }
    in_node && $1 ~ /^[[:space:]]*type[[:space:]]*$/ {
      value = $0
      sub(/^[^=]*=[[:space:]]*/, "", value)
      sub(/[[:space:]]*$/, "", value)
      print value
      exit
    }
  ' "$node_ini" 2> /dev/null || true
}

# Prints why this host asks for and stores no DID and DSP ports, and returns 0; returns 1 when it does.
# A secondary node shares or replicates the primary's database, so the primary owns the port rows;
# an image build or a container reconfigure has no deployment to store them for.
dsp_port_rows_skip_reason() {
  if [[ -v XROAD_IGNORE_DATABASE_SETUP ]]; then
    echo "XROAD_IGNORE_DATABASE_SETUP is set"
    return 0
  fi
  local node_type
  node_type=$(node_type)
  if [[ "$node_type" == "secondary" || "$node_type" == "slave" ]]; then
    echo "node.ini marks this host as a secondary node"
    return 0
  fi
  if [[ ! -d /run/systemd/system ]]; then
    echo "systemd is not the running init (image build or container reconfigure)"
    return 0
  fi
  return 1
}

# Prints the reason the given DID and DSP port answers are not acceptable; prints nothing when they are.
port_answers_error() {
  local did="$1" dsp="$2"
  normalize_port "$did" > /dev/null || { echo "The DID port '$did' is not a number from 1024 to 65535."; return; }
  normalize_port "$dsp" > /dev/null || { echo "The DSP port '$dsp' is not a number from 1024 to 65535."; return; }
  ports_differ "$did" "$dsp" || echo "The DID port and the DSP port must be different, both are '$did'."
}

if [ "$1" = "configure" ] && [ -z "$2" ] && ! dsp_port_rows_skip_reason > /dev/null; then
  while :; do
    asked=false
    if db_input high xroad-common/did-port; then asked=true; fi
    if db_input high xroad-common/dsp-port; then asked=true; fi
    db_go

    db_get xroad-common/did-port
    DID_PORT="$RET"
    db_get xroad-common/dsp-port
    DSP_PORT="$RET"

    ERR="$(port_answers_error "$DID_PORT" "$DSP_PORT")"
    # A preseeded or unasked answer cannot be corrected here; the postinst rejects it
    if [ -z "$ERR" ] || [ "$asked" = false ]; then
      break
    fi

    db_subst xroad-common/dsp-ports-error ERR "$(printf %s "$ERR" | debconf-escape -e)"
    db_input critical xroad-common/dsp-ports-error || true
    db_fset xroad-common/did-port seen false
    db_fset xroad-common/dsp-port seen false
    db_go
  done
fi

db_stop
