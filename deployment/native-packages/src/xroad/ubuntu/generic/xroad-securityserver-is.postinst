#!/bin/bash

if [ "$1" = configure ]; then
  for service in xroad-signer xroad-confclient xroad-proxy xroad-proxy-ui-api xroad-monitor xroad-opmonitor \
    xroad-auxiliary-service xroad-ds-control-plane xroad-ds-identity-hub; do
    invoke-rc.d --quiet "$service" try-restart || true
  done
fi

#DEBHELPER#

exit 0
