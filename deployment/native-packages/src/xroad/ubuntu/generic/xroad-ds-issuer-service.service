[Unit]
Description=X-Road DS Issuer Service
After=network.target xroad-base.service xroad-secret-store-local.service xroad-secret-store-remote.service
Requires=xroad-base.service
Wants=postgresql.service
Wants=xroad-secret-store-local.service xroad-secret-store-remote.service

[Service]
User=xroad
Group=xroad
Type=simple
ExecStart=/usr/share/xroad/bin/xroad-ds-issuer-service
Restart=on-failure
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
