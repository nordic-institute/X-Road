#!/bin/bash
. /usr/share/debconf/confmodule

abort() {
  local rc=$?
  echo >&2 "xroad-ds-identity-hub: FATAL: $*"
  exit $rc
}

if [[ "$1" == "configure" || "$1" == "reconfigure" ]]; then
  RET=
  db_get xroad-common/database-host || RET=""
  db_stop

  /usr/share/xroad/scripts/setup_ds_identityhub_db.sh "$RET" || abort "Database setup failed. ABORTING."
fi

#DEBHELPER#

exit 0
