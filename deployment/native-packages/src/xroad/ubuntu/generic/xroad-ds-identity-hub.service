[Unit]
Description=X-Road DS Identity Hub
After=network.target xroad-secret-store-local.service xroad-secret-store-remote.service
Wants=postgresql.service
Wants=xroad-signer.service
Wants=xroad-secret-store-local.service xroad-secret-store-remote.service

[Service]
User=xroad
Group=xroad
Type=simple
ExecStart=/usr/share/xroad/bin/xroad-ds-identity-hub
Restart=on-failure
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
