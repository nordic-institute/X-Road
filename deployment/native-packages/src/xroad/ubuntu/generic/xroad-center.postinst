#!/bin/bash
# postinst script for xroad-center

. /usr/share/debconf/confmodule
trap db_stop EXIT

. /usr/share/xroad/scripts/write_tls_config.sh

readonly NODE_INI=/etc/xroad/conf.d/node.ini
readonly NODE_NAME_PATTERN='^[A-Za-z0-9][A-Za-z0-9_-]{0,62}$'
NODE_NAME=""

abort() {
    local rc=$?
    echo -e "xroad-center: FATAL: $*" >&2
    exit $((rc == 0 ? 1 : rc))
}
log() { echo "xroad-center: $*" >&2; }
get_prop() { crudini --get "$1" '' "$2" 2>/dev/null || echo -n "$3"; }

gen_pw() {
  head -c 24 /dev/urandom | base64 | tr "/+" "_-"
}

# setup database and run migrations
setup_database() {
    /usr/share/xroad/scripts/migrate_db_cfg_to_spring_datasourse.sh

    local db_properties=/etc/xroad/db.properties
    local root_properties=/etc/xroad.properties
    RET=
    db_get xroad-common/database-host || true
    local -r new_db_host="${RET}"
    local db_host="${new_db_host:-127.0.0.1:5432}"

    RET=
    db_get xroad-common/skip-cs-db-migrations || true
    local skip_migrations="${RET}"
    crudini --set "${db_properties}" '' skip_migrations "${skip_migrations}"

    local db_user=$(get_prop ${db_properties} 'spring.datasource.username' 'centerui')
    local db_schema=$(get_prop ${db_properties} 'spring.datasource.hikari.data-source-properties.currentSchema' "${db_user%%@*}")
    db_schema=${db_schema%%,*}
    local db_password=$(get_prop ${db_properties} 'spring.datasource.password' 'centerui')
    local db_database="centerui_production"
    local db_master_user=postgres

    local db_url=$(get_prop ${db_properties} 'spring.datasource.url')
    if [[ -z "$db_url" ]]; then
      db_url="jdbc:postgresql://$db_host/$db_database"
      crudini --set "${db_properties}" '' spring.datasource.url "${db_url}"
    fi
    pat='^jdbc:postgresql://([^/]*)($|/([^\?]*)(.*)$)'
    if [[ "$db_url" =~ $pat ]]; then
      db_host=${new_db_host:-${BASH_REMATCH[1]}}
      db_database=${BASH_REMATCH[3]:-$db_database}
    else
      log "Unable to parse '$db_url', using 'jdbc:postgresql://$db_host/$db_database'"
    fi

    local db_admin_conn_user=$(get_prop ${root_properties} 'centerui.database.admin_user')
    local db_admin_password=$(get_prop ${root_properties} 'centerui.database.admin_password' 'centerui')
    if [[ -z "$db_admin_conn_user" && -n "$db_admin_password" ]]; then
      db_admin_conn_user="${db_user}_admin"
    else
      db_admin_conn_user="${db_admin_conn_user:-$db_user}"
      db_admin_password="${db_admin_password:-$db_password}"
    fi
    local db_admin_user="${db_admin_conn_user%%@*}"

    # Reading custom libpq ENV variables
    if [ -f /etc/xroad/db_libpq.env ]; then
      source /etc/xroad/db_libpq.env
    fi

    if [[ ! -z $PGOPTIONS_EXTRA ]]; then
      PGOPTIONS_EXTRA=" ${PGOPTIONS_EXTRA}"
    fi

    export PGOPTIONS="-c client-min-messages=warning -c search_path=$db_schema,public${PGOPTIONS_EXTRA-}"

    local hosts
    IFS=',' read -ra hosts <<<"$db_host"
    local db_addr=${hosts[0]%%:*}
    local db_port=${hosts[0]##*:}

    local_psql() { su -l -c "psql -qtA -p ${PGPORT:-$db_port} ${*@Q}" postgres; }
    remote_psql() { psql -h "${PGHOST:-$db_addr}" -p "${PGPORT:-$db_port}" -qtA "$@"; }

    psql_dbuser() {
        PGDATABASE="$db_database" PGUSER="$db_user" PGPASSWORD="$db_password" remote_psql "$@"
    }

    if [[ -f ${root_properties} && $(get_prop ${root_properties} postgres.connection.password) != "" ]]; then
        local db_master_passwd=$(get_prop ${root_properties} postgres.connection.password)
        db_master_user=$(get_prop ${root_properties} postgres.connection.user 'postgres')
        function psql_master() {
            PGDATABASE="postgres" PGPASSWORD="${db_master_passwd}" PGUSER="${db_master_user}" remote_psql "$@"
        }
    else
        function psql_master() { local_psql "$@"; }
    fi

    local db_plain_user=${db_user%%@*}

    if PGCONNECT_TIMEOUT=5 psql_dbuser -c "\q" &>/dev/null; then
        log "Database and user exists, skipping database creation."
    else

        if [[ $(get_prop ${root_properties} 'centerui.database.admin_user' "") == "" ]]; then
          db_admin_user="${db_user}_admin"
        fi

        if [[ $(get_prop ${root_properties} 'centerui.database.admin_password' "") == "" ]]; then
          db_admin_password=$(gen_pw)
        fi

        if [[ ! -f "$root_properties" ]]; then
          touch ${root_properties}
          chown root:root ${root_properties}
          chmod 600 ${root_properties}
        fi

        db_password=$(gen_pw)
        echo "Creating database"
        psql_master <<EOF || abort "Creating database '${db_database}' on '${db_host}' failed."
CREATE DATABASE "${db_database}" ENCODING 'UTF8';
REVOKE ALL ON DATABASE "${db_database}" FROM PUBLIC;
DO \$\$
BEGIN
  CREATE ROLE "${db_admin_user}" LOGIN PASSWORD '${db_admin_password}';
  GRANT "${db_admin_user}" TO "${db_master_user}";
  EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE 'User $db_admin_user already exists';
END
\$\$;
GRANT CREATE,TEMPORARY,CONNECT ON DATABASE "${db_database}" TO "${db_admin_user}";
\c "${db_database}"
CREATE EXTENSION hstore;
CREATE SCHEMA "${db_schema}" AUTHORIZATION "${db_admin_user}";
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE ON SCHEMA public TO "${db_admin_user}";
EOF
        echo "Creating database plain user"
        psql_master <<EOF || abort "Creating plain user failed."
DO \$\$
BEGIN
  CREATE ROLE "${db_plain_user}" LOGIN PASSWORD '${db_password}';
  GRANT "${db_plain_user}" TO "${db_master_user}";
  EXCEPTION WHEN OTHERS THEN
    RAISE NOTICE 'User $db_plain_user already exists';
END
\$\$;
\c "${db_database}"
GRANT TEMPORARY,CONNECT ON DATABASE "${db_database}" TO "${db_plain_user}";
GRANT USAGE ON SCHEMA public TO "${db_plain_user}";
EOF
        crudini --set "${db_properties}" '' spring.datasource.hikari.data-source-properties.currentSchema "${db_schema},public"
        crudini --set "${db_properties}" '' spring.datasource.username "centerui"
        crudini --set "${db_properties}" '' spring.datasource.password "${db_password}"

        crudini --set --inplace "${root_properties}" '' 'centerui.database.admin_user' "${db_admin_conn_user}"
        crudini --set --inplace "${root_properties}" '' 'centerui.database.admin_password' "${db_admin_password}"
    fi

    if [ "$skip_migrations" = true ] ; then
      echo "skipping database migrations"
    else
      /usr/share/xroad/scripts/setup_centerui_db.sh || abort "Database migration failed. ABORTING."
    fi
}

# Reads the node name from node.ini into NODE_NAME; it stays empty when the file or the name is
# absent. Aborts when the file exists but cannot be read or parsed.
load_node_name() {
  NODE_NAME=""
  [[ -e "$NODE_INI" ]] || return 0
  crudini --get "$NODE_INI" >/dev/null 2>&1 \
    || abort "Cannot read ${NODE_INI}: the file is unreadable or malformed. ABORTING."
  NODE_NAME=$(crudini --get "$NODE_INI" node name 2>/dev/null) || NODE_NAME=""
}

# Aborts unless the name follows the node name rule of the Central Server services.
check_node_name() {
  local LC_ALL=C
  [[ "$1" =~ $NODE_NAME_PATTERN ]] \
    || abort "The node name '$1' is not valid. It must start with a letter or digit, followed by letters, digits, '_' or '-', at most 63 characters in total. ABORTING."
}

# Writes the node name answer to node.ini on a first install of a node that has no name yet.
# An empty answer keeps the Central Server standalone (node_0). Nothing is written for a name
# that breaks the node name rule.
# Arguments: $1 - the postinst action, $2 - the previously configured version, empty on a first install
store_node_name() {
  [[ "$1" == "configure" && -z "$2" ]] || return 0
  [[ -z "$NODE_NAME" ]] || return 0

  RET=""
  db_get xroad-common/node-name || true
  local node_name="$RET"
  [[ -n "$node_name" ]] || return 0
  check_node_name "$node_name"

  crudini --set "$NODE_INI" node name "$node_name" || abort "Failed to write the node name to ${NODE_INI}. ABORTING."
  chown xroad:xroad "$NODE_INI"
  chmod 0640 "$NODE_INI"
  NODE_NAME="$node_name"
  log "Central Server node name set to '${node_name}' in ${NODE_INI}"
}

# Prints the stored value of a TLS identity row as this node uses it: its own row, else the shared
# row. Fails when there is no row. A row with an empty value exists.
# Arguments: $1 - module name, $2 - row key (common-name, alt-names, ip-subject-alt-names)
stored_tls_row() {
  read_effective_tls_row "xroad.$1.tls.certificate-provisioning.$2" "$NODE_NAME" 2>/dev/null
}

# Prints the IP and DNS alternative name lists in the IP:<address>,DNS:<name> answer format.
# Arguments: $1 - comma-separated addresses, $2 - comma-separated names
format_alt_names() {
  local item out=""
  local -a items
  IFS=, read -ra items <<<"$1"
  for item in "${items[@]}"; do
    [[ -n "$item" ]] && out+="IP:${item},"
  done
  IFS=, read -ra items <<<"$2"
  for item in "${items[@]}"; do
    [[ -n "$item" ]] && out+="DNS:${item},"
  done
  echo "${out%,}"
}

# Sets the defaults of the two questions of a module and asks them. The default is the value this
# node uses (its row, else the shared row), else the previous or preseeded answer, else the host value.
# Arguments: $1 - module name, $2 - subject question, $3 - alternative names question
ask_tls_names() {
  local module="$1" subject_question="$2" alt_question="$3"
  local stored_subject stored_ips stored_dns
  local has_subject=false has_ips=false has_dns=false

  stored_subject=$(stored_tls_row "$module" common-name) && has_subject=true
  stored_ips=$(stored_tls_row "$module" ip-subject-alt-names) && has_ips=true
  stored_dns=$(stored_tls_row "$module" alt-names) && has_dns=true

  db_subst "$subject_question" HOST "$HOST"
  db_subst "$alt_question" ALT "$ALT"

  if [[ "$has_subject" == true ]]; then
    db_set "$subject_question" "$stored_subject"
  else
    db_get "$subject_question"
    [ -z "$RET" ] && db_set "$subject_question" "$HOST"
  fi
  if [[ "$has_ips" == true || "$has_dns" == true ]]; then
    [[ "$has_ips" == true ]] || stored_ips=$(extract_ip_list "$ALT")
    [[ "$has_dns" == true ]] || stored_dns=$(extract_dns_list "$ALT")
    db_set "$alt_question" "$(format_alt_names "$stored_ips" "$stored_dns")"
  else
    db_get "$alt_question"
    [ -z "$RET" ] && db_set "$alt_question" "$ALT"
  fi

  db_beginblock
  db_input critical "$subject_question" || true
  db_input critical "$alt_question" || true
  db_endblock
  db_go
}

prepare_certificates_settings() {
  HOST=$(detect_host_name)
  ALT=$(detect_alt_names)

  log "Preparing center-admin-service certificate properties"
  ask_tls_names admin-service xroad-common/admin-subject xroad-common/admin-altsubject

  log "Preparing management service certificate properties"
  ask_tls_names management-service xroad-common/service-subject xroad-common/service-altsubject
}

# Stores the answers collected by prepare_certificates_settings as identity rows: node rows on a
# named node, shared rows otherwise. A key is written only when it has no row or the answer differs
# from the value the node uses, so shared names set for all nodes keep applying. Must run after
# setup_database() so the configuration_properties table exists.
# Arguments: $1 - the postinst action
store_certificates_settings() {
  local node_arg=""
  [[ -n "$NODE_NAME" ]] && node_arg=" --node ${NODE_NAME@Q}"

  local admin_subject admin_altn service_subject service_altn
  RET=""
  db_get xroad-common/admin-subject || true; admin_subject="$RET"
  db_get xroad-common/admin-altsubject || true; admin_altn="$RET"
  db_get xroad-common/service-subject || true; service_subject="$RET"
  db_get xroad-common/service-altsubject || true; service_altn="$RET"

  RET=""
  db_get xroad-common/skip-cs-db-migrations || true
  if [[ "$RET" == "true" ]]; then
    log "Database migrations were skipped, TLS identity rows not stored. Once the schema is migrated, store the answers with:"
    log "  /usr/share/xroad/scripts/write_tls_config.sh set admin-service ${admin_subject@Q} ${admin_altn@Q}${node_arg} --yes"
    log "  /usr/share/xroad/scripts/write_tls_config.sh set management-service ${service_subject@Q} ${service_altn@Q}${node_arg} --yes"
    log "or run 'dpkg-reconfigure xroad-center' and answer No to skipping migrations"
    return
  fi

  write_tls_identity_rows admin-service "$admin_subject" "$admin_altn" "" "$NODE_NAME" if-changed \
    || abort "Failed to store admin-service TLS identity. ABORTING."
  write_tls_identity_rows management-service "$service_subject" "$service_altn" "" "$NODE_NAME" if-changed \
    || abort "Failed to store management-service TLS identity. ABORTING."

  if [[ "${DEBCONF_RECONFIGURE:-}" == "1" || "${1:-}" == "reconfigure" ]]; then
    log "A TLS key that already exists keeps its names. To issue it again with the new names, delete the key and restart the service:"
    log "  xrd-secret/tls/admin-service/${NODE_NAME:-node_0}"
    log "  xrd-secret/tls/management-service/${NODE_NAME:-node_0}"
  fi
}

case "$1" in
configure | reconfigure)
    load_node_name
    store_node_name "$1" "$2"
    setup_database
    prepare_certificates_settings
    store_certificates_settings "$1"

    RET=""
    db_get xroad-common/username
    AUSER="$RET"

    #add groups
    groups="xroad-security-officer xroad-system-administrator xroad-registration-officer"
    usergroups=" $(id -Gn "$AUSER") "
    for groupname in $groups; do
        if ! getent group "$groupname" >/dev/null; then
            groupadd --system "$groupname" || true
        fi
        if [[ $usergroups != *" $groupname "* ]]; then
            usermod -a -G "$groupname" "$AUSER" || true
        fi
    done

    chmod 755 /var/lib/xroad/public
    chown xroad:xroad /var/lib/xroad/public

    test -d /var/cache/xroad && test -w /var/cache/xroad || mkdir /var/cache/xroad
    chown xroad:xroad /var/cache/xroad
    test -d /etc/xroad/configuration-parts || mkdir /etc/xroad/configuration-parts
    chown xroad:xroad /etc/xroad/configuration-parts

    mkdir -p /var/lib/xroad/import
    chmod 755 /var/lib/xroad/import
    chown xroad:xroad /var/lib/xroad/import

    #create backups folder
    mkdir -p /var/lib/xroad/backup
    chown xroad:xroad /var/lib/xroad/backup

    # generate gpg keypair when needed - directory does not exist and server is initialised
    if [[ -n "$2" ]]; then
      if [ ! -d /etc/xroad/gpghome ] ; then
        ID=$(/usr/share/xroad/scripts/get_central_server_instance_id.sh)
        if [[ -n "${ID}" ]] ; then
          /usr/share/xroad/scripts/generate_gpg_keypair.sh /etc/xroad/gpghome "${ID}"
        fi
      fi
      # always fix gpghome ownership
      [ -d /etc/xroad/gpghome ] && chown -R xroad:xroad /etc/xroad/gpghome
    fi

    #create symlink to nginx config
    if [[ -d /etc/nginx/sites-enabled ]]; then
      ln -sf /etc/xroad/nginx/xroad-public.conf /etc/nginx/sites-enabled/xroad-public
    fi

    invoke-rc.d --quiet rsyslog try-restart || true
    invoke-rc.d --quiet nginx try-restart || true
    invoke-rc.d --quiet xroad-signer try-restart || true
    ;;

abort-upgrade | abort-remove | abort-deconfigure)
    ;;

*)
    log "postinst called with unknown argument '$1'" >&2
    exit 1
    ;;
esac

#DEBHELPER#

exit 0
