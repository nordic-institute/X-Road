[Unit]
Description=X-Road Configuration Proxy
After=network.target xroad-base.service xroad-secret-store-local.service xroad-secret-store-remote.service
Requires=xroad-base.service
Wants=xroad-signer.service

[Service]
User=xroad
Group=xroad
Type=notify
NotifyAccess=all
ExecStart=/usr/share/xroad/bin/xroad-confproxy
Restart=on-failure
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target

