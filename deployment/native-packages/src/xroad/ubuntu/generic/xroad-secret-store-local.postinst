#!/bin/bash
. /usr/share/debconf/confmodule

set -e

if [ "$1" = "configure" ]; then
  chown xroad:xroad /etc/xroad/backup.d/??_openbao
  chmod 0440 /etc/xroad/backup.d/??_openbao

  chgrp -R xroad /etc/openbao # Ensure that OpenBao configuration is readable for backup creation

  # Only perform initialization on fresh install
  if [ -z "$2" ]; then # $2 is empty for fresh installs
    RET=""
    db_get xroad-common/secret-store-join || RET=""
    join=false
    if [ "$RET" = "true" ]; then
      join=true
    fi

    if [ "$join" = true ]; then
      # A joining node uses the imported database settings and creates no database
      /usr/share/xroad/scripts/secret-store-join-bundle.sh check
      chown openbao:xroad /etc/openbao/openbao.env
      chmod 0640 /etc/openbao/openbao.env
    else
      # Initialize PostgreSQL storage
      RET=""
      db_get xroad-common/database-host || RET=""
      /usr/share/xroad/scripts/secret-store-init-db.sh "$RET"
    fi

    # Write the OpenBao configuration, generate its TLS certificate and install it as trusted
    config_args=()
    RET=""
    db_get xroad-common/secret-store-node-address || RET=""
    if [ -n "$RET" ]; then
      config_args+=(--node-address "$RET")
      RET=""
      db_get xroad-common/secret-store-node-host || RET=""
      if [ -n "$RET" ]; then
        config_args+=(--node-host "$RET")
      fi
      RET=""
      db_get xroad-common/secret-store-disable-standby-reads || RET=""
      if [ "$RET" = "true" ]; then
        config_args+=(--disable-standby-reads)
      fi
    fi
    /usr/share/xroad/scripts/secret-store-cluster-config.sh "${config_args[@]}"

    # Enable and start OpenBao with error handling
    if ! deb-systemd-invoke enable openbao.service; then
      echo "Failed to enable OpenBao service"
      exit 1
    fi

    if ! deb-systemd-invoke restart openbao.service; then
      echo "Failed to start OpenBao service"
      exit 1
    fi

    if [ "$join" = true ]; then
      echo "Joining the OpenBao cluster.."
      /usr/share/xroad/scripts/secret-store-init.sh --join
    fi

    echo "Initializing OpenBao.."
    deb-systemd-invoke enable xroad-secret-store-local.service
    deb-systemd-invoke start xroad-secret-store-local.service
  else
    echo "Upgrade detected, skipping initialization; rerunning the OpenBao setup"
    deb-systemd-invoke restart xroad-secret-store-local.service ||
      echo "OpenBao setup failed, see: systemctl status xroad-secret-store-local.service"
  fi
fi
