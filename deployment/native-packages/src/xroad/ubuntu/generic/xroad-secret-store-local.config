#!/bin/bash -e

. /usr/share/debconf/confmodule

if [ "$1" = "configure" ] || [ "$1" = "reconfigure" ]; then
  # Get database connection string from the user
  if [ -s /etc/openbao/xroad-openbao.env ]; then
    bao_pg_host=""
    bao_pg_port=""
    while IFS= read -r line || [ -n "$line" ]; do
      line=${line%$'\r'}
      case "$line" in
        BAO_PG_HOST=*) bao_pg_host=${line#*=} ;;
        BAO_PG_PORT=*) bao_pg_port=${line#*=} ;;
      esac
    done </etc/openbao/xroad-openbao.env || true
    if [ -n "$bao_pg_host" ]; then
      db_set xroad-common/database-host "${bao_pg_host}:${bao_pg_port:-5432}" || true
    fi
  fi

  db_input critical xroad-common/database-host || true
  db_go

  if [ "$1" = "configure" ] && [ -z "$2" ]; then
    db_input low xroad-common/secret-store-join || true
    db_input low xroad-common/secret-store-node-address || true
    db_input low xroad-common/secret-store-node-host || true
    db_input low xroad-common/secret-store-disable-standby-reads || true
    db_go
  fi

fi

db_stop
