---
{% set ds_tls = ds_tls_enabled | default(false) | bool %}
{% set ds_truststore_file = ds_truststore_key | default('cacerts') %}
{% set ds_truststore_opts = '-Djavax.net.ssl.trustStore=/etc/xroad/ssl/' ~ ds_truststore_file ~ ' -Djavax.net.ssl.trustStorePassword=changeit' %}
{# Advertised DS hostnames. In k8s the ds-* services are separate, namespace-scoped Services, so
   each is addressed on its own namespace-qualified name — the same rule the rest of this
   topology follows, and the names the ds-https cert's SAN list already carries. #}
{% set ds_cp_host = 'ds-control-plane.' ~ security_server_namespace %}
{% set ds_ih_host = 'ds-identity-hub.' ~ security_server_namespace %}
{% set ds_serverproxy_host = 'proxy.' ~ security_server_namespace %}
{% set ds_participant_id = dsp_participant_context_id %}
{% set messagelog_encryption_enabled = (messagelog_encryption_config | default('')) | length > 0 %}
{% if (xroad_image_registry | length > 0) or jvm_metrics_enabled %}
global:
{% if xroad_image_registry | length > 0 %}
  image:
    registry: {{ xroad_image_registry }}
{% if xroad_image_tag | length > 0 %}
    tag: {{ xroad_image_tag }}
{% endif %}
{% endif %}
{% if jvm_metrics_enabled %}
  extraPodAnnotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "9801"
    prometheus.io/path: "/metrics"
{% endif %}
{% endif %}

init:
  serverconf:
    dbUsername: {{ serverconf_db.username }}
  messagelog:
    dbUsername: {{ messagelog_db.username }}
  opmonitor:
    dbUsername: {{ opmonitor_db.username }}

{% set proxy_env = {
  'XROAD_PROXY_ADDON_OP_MONITOR_ENABLED': 'true',
  'XROAD_PROXY_DSP_ENABLED': proxy_dsp_enabled | string | lower,
  'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt',
} %}
{% if (op_monitor_records_available_offset_seconds | default('')) | length > 0 %}
{% set _ = proxy_env.update({
  'XROAD_OP_MONITOR_RECORDS_AVAILABLE_TIMESTAMP_OFFSET_SECONDS': op_monitor_records_available_offset_seconds,
}) %}
{% endif %}
{% if proxy_timestamp_immediately | default(false) | bool %}
{% set _ = proxy_env.update({
  'XROAD_PROXY_MESSAGE_LOG_TIMESTAMPER_TIMESTAMP_IMMEDIATELY': 'true',
}) %}
{% endif %}
{% if (common_global_conf_refresh_rate | default('')) | length > 0 %}
{% set _ = proxy_env.update({
  'XROAD_COMMON_GLOBAL_CONF_REFRESH_RATE': common_global_conf_refresh_rate,
}) %}
{% endif %}
{% if proxy_batch_signing_enabled | default(false) | bool %}
{% set _ = proxy_env.update({
  'XROAD_PROXY_BATCH_SIGNING_ENABLED': 'true',
}) %}
{% endif %}
{% if ds_tls %}
{% set _ = proxy_env.update({
  'JAVA_TOOL_OPTIONS': ds_truststore_opts,
}) %}
{% endif %}
{# Where this Security Server advertises its own server proxy for the DSP data plane. The product
   default is https://localhost:5500, which only holds when consumer and provider share a host;
   compose overrides it per stack and a multi-release k8s topology needs the same per release. #}
{% if proxy_dsp_enabled %}
{% set _ = proxy_env.update({
  'XROAD_PROXY_DSP_SERVERPROXY_ENDPOINT': 'https://' ~ ds_serverproxy_host ~ ':5500',
}) %}
{% endif %}
services:
{% for svc, extra_env in [
  ('configuration-client', {'XROAD_CONFIGURATION_CLIENT_UPDATE_INTERVAL': configuration_client_update_interval, 'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt'}),
  ('signer', {'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt'}),
  ('proxy', proxy_env),
  ('monitor', {'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt'}),
] %}
  {{ svc }}:
    env:
{% for k, v in extra_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    extraVolumes:
      - name: {{ svc }}-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
{% if ds_tls and svc == 'proxy' %}
      - name: {{ svc }}-ds-https
        secret:
          secretName: ds-https-keystore
{% endif %}
{% if messagelog_encryption_enabled and svc == 'proxy' %}
      - name: message-log-encryption-config
        configMap:
          name: message-log-encryption-config
{% endif %}
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: {{ svc }}-openbao-tls-certificate
{% if ds_tls and svc == 'proxy' %}
      - mountPath: /etc/xroad/ssl/{{ ds_truststore_file }}
        subPath: {{ ds_truststore_file }}
        name: {{ svc }}-ds-https
{% endif %}
{% if messagelog_encryption_enabled and svc == 'proxy' %}
      # Projected as a single file (not a directory mount over /opt/app/config)
      # since the image ships nothing there today but future packaged config
      # would otherwise be shadowed wholesale by a directory volume.
      - mountPath: /opt/app/config/application.yaml
        subPath: application.yaml
        name: message-log-encryption-config
{% endif %}
{% endfor %}

  proxy-ui-api:
    env:
      SPRING_CLOUD_VAULT_SSL_TRUST_STORE: "file:/etc/xroad/ssl/openbao.crt"
      SPRING_CLOUD_VAULT_SSL_TRUST_STORE_TYPE: "PEM"
{% if ds_tls %}
      # Dataspace provisioning via the proxy-ui-api endpoint (replaces the manual IH/CP seed).
      # identity-hub-url is the advertised identity-hub host, so the derived holder DID /
      # credentialService / STS URL resolve for whoever issues credentials — each release's own
      # namespace-qualified Service.
      XROAD_PROXY_UI_API_DATASPACE_ENABLED: "true"
      XROAD_PROXY_UI_API_DATASPACE_IDENTITY_HUB_URL: "https://{{ ds_ih_host }}:7182"
      XROAD_PROXY_UI_API_DATASPACE_PARTICIPANT_ID: "{{ ds_participant_id }}"
      XROAD_PROXY_UI_API_DATASPACE_MANAGEMENT_CONTEXT_ENABLED: "{{ (ds_mgmt_context_enabled | default(false) | bool) | ternary('true', 'false') }}"
      XROAD_PROXY_UI_API_DATASPACE_ISSUER_DID: "did:web:{{ trusted_issuer_host | default('xrd-cs') }}%3A6183:issuer"
{% endif %}
    extraVolumes:
      - name: proxy-ui-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: proxy-ui-openbao-tls-certificate

  op-monitor:
    enabled: true
    env:
      QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if (op_monitor_records_available_offset_seconds | default('')) | length > 0 %}
      XROAD_OP_MONITOR_RECORDS_AVAILABLE_TIMESTAMP_OFFSET_SECONDS: "{{ op_monitor_records_available_offset_seconds }}"
{% endif %}
    extraVolumes:
      - name: op-monitor-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: op-monitor-openbao-tls-certificate

{% if proxy_dsp_enabled %}
  # DSP services — bump replicas from chart default of 0. DB clusters are
  # provisioned by the cloudnative_pg role (see ds_*_db vars).
  # ds-* services talk to OpenBao over HTTPS via the Quarkus vault client,
  # so they need the same openbao TLS cert mount as proxy/signer/monitor.
  # With ds_tls the shared self-signed keystore (ds-https-keystore chart)
  # lights up HTTPS on every EDC port.
{% for svc in ['ds-control-plane', 'ds-identity-hub', 'ds-issuer-service'] %}
  {{ svc }}:
    replicas: 1
{% if ds_tls and svc in ['ds-identity-hub', 'ds-issuer-service'] %}
    # These two default to probing an EDC web port, which ds-https flips to
    # TLS — and Jetty's sniHostCheck rejects kubelet's by-IP probes (400
    # Invalid SNI). Probe the plain-HTTP quarkus health port instead, same
    # as ds-control-plane.
    readinessProbe:
      path: "/q/health"
      port: 4099
      scheme: "HTTP"
    livenessProbe:
      path: "/q/health"
      port: 4099
      scheme: "HTTP"
{% endif %}
    env:
      QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if ds_tls %}
      EDC_WEB_HTTPS_KEYSTORE_PATH: "/etc/xroad/ssl/ds-https.p12"
      EDC_WEB_HTTPS_KEYSTORE_TYPE: "PKCS12"
      EDC_WEB_HTTPS_KEYSTORE_PASSWORD: "changeit"
      EDC_WEB_HTTPS_KEYMANAGER_PASSWORD: "changeit"
      JAVA_TOOL_OPTIONS: "{{ ds_truststore_opts }}"
{% if svc == 'ds-control-plane' %}
      EDC_DSP_CALLBACK_ADDRESS: "https://{{ ds_cp_host }}:8183/api/dsp/%s"
      EDC_IAM_DID_WEB_USE_HTTPS: "true"
{% endif %}
{% if svc == 'ds-identity-hub' %}
      EDC_IH_DID_PUBLIC_HOSTNAME: "{{ ds_ih_host }}"
      EDC_IAM_DID_WEB_USE_HTTPS: "true"
{% endif %}
{% endif %}
    extraVolumes:
      - name: {{ svc }}-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
{% if ds_tls %}
      - name: {{ svc }}-ds-https
        secret:
          secretName: ds-https-keystore
{% endif %}
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: {{ svc }}-openbao-tls-certificate
{% if ds_tls %}
      - mountPath: /etc/xroad/ssl/ds-https.p12
        subPath: ds-https.p12
        name: {{ svc }}-ds-https
      - mountPath: /etc/xroad/ssl/{{ ds_truststore_file }}
        subPath: {{ ds_truststore_file }}
        name: {{ svc }}-ds-https
{% endif %}
{% endfor %}
{% endif %}
{% if softtoken_signer_enabled | default(false) | bool %}
  softtoken-signer:
    replicas: 1
{% endif %}
  auxiliary-service:
    env:
{% if serverconf_init_image | length > 0 %}
      SERVERCONF_INIT_IMAGE: {{ serverconf_init_image }}
{% endif %}
      QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if (messagelog_archive_cron | default('')) | length > 0 %}
      XROAD_AUXILIARY_SERVICE_MESSAGE_LOG_ARCHIVE_CRON: "{{ messagelog_archive_cron }}"
{% endif %}
{% if (messagelog_clean_cron | default('')) | length > 0 %}
      XROAD_AUXILIARY_SERVICE_MESSAGE_LOG_CLEAN_CRON: "{{ messagelog_clean_cron }}"
{% endif %}
    extraVolumes:
      - name: auxiliary-service-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: auxiliary-service-openbao-tls-certificate

messageLogArchiver:
  env:
    QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if (messagelog_archiver_clean_keep_records_for | default('')) | length > 0 %}
    XROAD_MESSAGE_LOG_ARCHIVER_CLEAN_KEEP_RECORDS_FOR: "{{ messagelog_archiver_clean_keep_records_for }}"
{% endif %}
  # The archiver's own Pod gets none of the auxiliary-service Deployment's mounts,
  # so the CA cert QUARKUS_VAULT_TLS_CA_CERT above names has to be mounted here too.
  # Unconditional: any archiver run that reaches OpenBao needs it, and messagelog
  # encryption makes that mandatory rather than incidental — without it the Vault
  # read fails closed as "No encryption keys found in Vault".
  extraVolumes:
    - name: message-log-archiver-openbao-tls-certificate
      secret:
        secretName: {{ openbao_tls_secret_name }}
        items:
          - key: tls.crt
            path: openbao.crt
{% if messagelog_encryption_enabled %}
    - name: message-log-encryption-config
      configMap:
        name: message-log-encryption-config
{% endif %}
  extraVolumeMounts:
    - mountPath: /etc/xroad/ssl/openbao.crt
      subPath: openbao.crt
      name: message-log-archiver-openbao-tls-certificate
{% if messagelog_encryption_enabled %}
    # Same Job template serves both the archive and cleanup CLI invocations, so
    # one mount covers both — see MessageLogEncryptionProperties.
    - mountPath: /opt/app/config/application.yaml
      subPath: application.yaml
      name: message-log-encryption-config
{% endif %}

{% if messagelog_encryption_enabled %}
messageLogEncryption:
  enabled: true
  applicationYaml: |
{{ messagelog_encryption_config | indent(4, true) }}
{% endif %}

{% if jvm_metrics_enabled %}
jvmMetrics:
  enabled: true
{% endif %}

{% if otel_enabled | default(false) | bool %}
otel:
  enabled: true
  nodeId: "{{ otel_node_id | default('') }}"
  endpoint: {{ otel_endpoint }}
  protocol: "{{ otel_protocol | default('grpc') }}"
  sampler: {{ otel_sampler }}
  resourceAttributes:
    serviceNamespace: xroad
    deploymentEnvironment: {{ otel_deployment_environment }}
{% endif %}

{% if signer_hsm_enabled | default(false) | bool %}
signer:
  hsm:
    enabled: true
{% endif %}

{% set dsp_participant_context_id = dsp_participant_context_id | default('') %}
{% if ds_tls or (dsp_participant_context_id | length > 0) %}
dsp:
{% if ds_tls %}
  seed:
    trustedIssuerDid: "did:web:{{ trusted_issuer_host | default('xrd-cs') }}%3A6183:issuer"
{% endif %}
{% if dsp_participant_context_id | length > 0 %}
  participantContextId: "{{ dsp_participant_context_id }}"
{% endif %}
{% endif %}

# Postgres image used by DSP wait-gate initContainers. The DB clusters
# themselves are provisioned by the cloudnative_pg role, not the chart.
postgres:
  image: "{{ postgres_image }}"

{% if (xroad_image_pull_secret | default('')) | length > 0 %}
imagePullSecrets:
  - {{ xroad_image_pull_secret }}
{% endif %}
