---
{% set ds_tls = ss2_advertised_host is defined %}
{% set ds_truststore_opts = '-Djavax.net.ssl.trustStore=/etc/xroad/ssl/cacerts.p12 -Djavax.net.ssl.trustStorePassword=changeit' %}
{% if (xroad_image_registry | length > 0) or jvm_metrics_enabled %}
global:
{% if xroad_image_registry | length > 0 %}
  image:
    registry: {{ xroad_image_registry }}
{% if xroad_image_tag | length > 0 %}
    tag: {{ xroad_image_tag }}
{% endif %}
{% endif %}
{% if jvm_metrics_enabled %}
  extraPodAnnotations:
    prometheus.io/scrape: "true"
    prometheus.io/port: "9801"
    prometheus.io/path: "/metrics"
{% endif %}
{% endif %}

init:
  serverconf:
    dbUsername: {{ serverconf_db.username }}
  messagelog:
    dbUsername: {{ messagelog_db.username }}
  opmonitor:
    dbUsername: {{ opmonitor_db.username }}

{% set proxy_env = {
  'XROAD_PROXY_ADDON_OP_MONITOR_ENABLED': 'true',
  'XROAD_PROXY_DSP_ENABLED': proxy_dsp_enabled | string | lower,
  'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt',
} %}
{% if (op_monitor_records_available_offset_seconds | default('')) | length > 0 %}
{% set _ = proxy_env.update({
  'XROAD_OP_MONITOR_RECORDS_AVAILABLE_TIMESTAMP_OFFSET_SECONDS': op_monitor_records_available_offset_seconds,
}) %}
{% endif %}
{% if proxy_timestamp_immediately | default(false) | bool %}
{% set _ = proxy_env.update({
  'XROAD_PROXY_MESSAGE_LOG_TIMESTAMPER_TIMESTAMP_IMMEDIATELY': 'true',
}) %}
{% endif %}
{% if (common_global_conf_refresh_rate | default('')) | length > 0 %}
{% set _ = proxy_env.update({
  'XROAD_COMMON_GLOBAL_CONF_REFRESH_RATE': common_global_conf_refresh_rate,
}) %}
{% endif %}
{% if proxy_batch_signing_enabled | default(false) | bool %}
{% set _ = proxy_env.update({
  'XROAD_PROXY_BATCH_SIGNING_ENABLED': 'true',
}) %}
{% endif %}
{% if ds_tls %}
{% set _ = proxy_env.update({
  'XROAD_PROXY_DSP_PARTICIPANT_CONTEXT_ID': ss2_advertised_host,
  'JAVA_TOOL_OPTIONS': ds_truststore_opts,
}) %}
{% endif %}
services:
{% for svc, extra_env in [
  ('configuration-client', {'XROAD_CONFIGURATION_CLIENT_UPDATE_INTERVAL': configuration_client_update_interval, 'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt'}),
  ('signer', {'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt'}),
  ('proxy', proxy_env),
  ('monitor', {'QUARKUS_VAULT_TLS_CA_CERT': '/etc/xroad/ssl/openbao.crt'}),
] %}
  {{ svc }}:
    env:
{% for k, v in extra_env.items() %}
      {{ k }}: "{{ v }}"
{% endfor %}
    extraVolumes:
      - name: {{ svc }}-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
{% if ds_tls and svc == 'proxy' %}
      - name: {{ svc }}-ds-https
        secret:
          secretName: ds-https-keystore
{% endif %}
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: {{ svc }}-openbao-tls-certificate
{% if ds_tls and svc == 'proxy' %}
      - mountPath: /etc/xroad/ssl/cacerts.p12
        subPath: cacerts.p12
        name: {{ svc }}-ds-https
{% endif %}
{% endfor %}

  proxy-ui-api:
    env:
      SPRING_CLOUD_VAULT_SSL_TRUST_STORE: "file:/etc/xroad/ssl/openbao.crt"
      SPRING_CLOUD_VAULT_SSL_TRUST_STORE_TYPE: "PEM"
{% if ds_tls %}
      # Dataspace provisioning via the proxy-ui-api endpoint (replaces the manual
      # IH/CP seed). identity-hub-url is the advertised host so the derived holder
      # DID / credentialService / STS URL are resolvable by the LXD issuer; the
      # in-cluster proxy-ui-api reaches it through the xrd-ss2.lxd hostAlias.
      XROAD_PROXY_UI_API_DATASPACE_ENABLED: "true"
      XROAD_PROXY_UI_API_DATASPACE_IDENTITY_HUB_URL: "https://{{ ss2_advertised_host }}:7182"
      XROAD_PROXY_UI_API_DATASPACE_PARTICIPANT_ID: "{{ ss2_advertised_host }}"
      XROAD_PROXY_UI_API_DATASPACE_MANAGEMENT_CONTEXT_ENABLED: "false"
      XROAD_PROXY_UI_API_DATASPACE_ISSUER_DID: "did:web:xrd-cs%3A6183:issuer"
{% endif %}
    extraVolumes:
      - name: proxy-ui-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: proxy-ui-openbao-tls-certificate

  op-monitor:
    enabled: true
    env:
      QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if (op_monitor_records_available_offset_seconds | default('')) | length > 0 %}
      XROAD_OP_MONITOR_RECORDS_AVAILABLE_TIMESTAMP_OFFSET_SECONDS: "{{ op_monitor_records_available_offset_seconds }}"
{% endif %}
    extraVolumes:
      - name: op-monitor-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: op-monitor-openbao-tls-certificate

{% if proxy_dsp_enabled %}
  # DSP services — bump replicas from chart default of 0. DB clusters are
  # provisioned by the cloudnative_pg role (see ds_*_db vars).
  # ds-* services talk to OpenBao over HTTPS via the Quarkus vault client,
  # so they need the same openbao TLS cert mount as proxy/signer/monitor.
  # With ds_tls the shared xrd-ca-signed keystore lights up HTTPS on every
  # EDC port, matching the LXD stack's ds-https-keystore.yml behaviour.
{% for svc in ['ds-control-plane', 'ds-identity-hub', 'ds-issuer-service'] %}
  {{ svc }}:
    replicas: 1
{% if ds_tls and svc in ['ds-identity-hub', 'ds-issuer-service'] %}
    # These two default to probing an EDC web port, which ds-https flips to
    # TLS — and Jetty's sniHostCheck rejects kubelet's by-IP probes (400
    # Invalid SNI). Probe the plain-HTTP quarkus health port instead, same
    # as ds-control-plane.
    readinessProbe:
      path: "/q/health"
      port: 4099
      scheme: "HTTP"
    livenessProbe:
      path: "/q/health"
      port: 4099
      scheme: "HTTP"
{% endif %}
    env:
      QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if ds_tls %}
      EDC_WEB_HTTPS_KEYSTORE_PATH: "/etc/xroad/ssl/ds-https.p12"
      EDC_WEB_HTTPS_KEYSTORE_TYPE: "PKCS12"
      EDC_WEB_HTTPS_KEYSTORE_PASSWORD: "changeit"
      EDC_WEB_HTTPS_KEYMANAGER_PASSWORD: "changeit"
      JAVA_TOOL_OPTIONS: "{{ ds_truststore_opts }}"
{% if svc == 'ds-control-plane' %}
      XROAD_DSP_PARTICIPANT_CONTEXT_ID: "{{ ss2_advertised_host }}"
      EDC_DSP_CALLBACK_ADDRESS: "https://{{ ss2_advertised_host }}:8183/api/dsp/%s"
      EDC_IAM_DID_WEB_USE_HTTPS: "true"
{% endif %}
{% if svc == 'ds-identity-hub' %}
      EDC_IH_DID_PUBLIC_HOSTNAME: "{{ ss2_advertised_host }}"
      EDC_IAM_DID_WEB_USE_HTTPS: "true"
{% endif %}
{% endif %}
    extraVolumes:
      - name: {{ svc }}-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
{% if ds_tls %}
      - name: {{ svc }}-ds-https
        secret:
          secretName: ds-https-keystore
{% endif %}
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: {{ svc }}-openbao-tls-certificate
{% if ds_tls %}
      - mountPath: /etc/xroad/ssl/ds-https.p12
        subPath: ds-https.p12
        name: {{ svc }}-ds-https
      - mountPath: /etc/xroad/ssl/cacerts.p12
        subPath: cacerts.p12
        name: {{ svc }}-ds-https
{% endif %}
{% endfor %}
{% endif %}
  auxiliary-service:
    env:
{% if serverconf_init_image | length > 0 %}
      SERVERCONF_INIT_IMAGE: {{ serverconf_init_image }}
{% endif %}
      QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if (messagelog_archive_cron | default('')) | length > 0 %}
      XROAD_AUXILIARY_SERVICE_MESSAGE_LOG_ARCHIVE_CRON: "{{ messagelog_archive_cron }}"
{% endif %}
{% if (messagelog_clean_cron | default('')) | length > 0 %}
      XROAD_AUXILIARY_SERVICE_MESSAGE_LOG_CLEAN_CRON: "{{ messagelog_clean_cron }}"
{% endif %}
    extraVolumes:
      - name: auxiliary-service-openbao-tls-certificate
        secret:
          secretName: {{ openbao_tls_secret_name }}
          items:
            - key: tls.crt
              path: openbao.crt
    extraVolumeMounts:
      - mountPath: /etc/xroad/ssl/openbao.crt
        subPath: openbao.crt
        name: auxiliary-service-openbao-tls-certificate

messageLogArchiver:
  env:
    QUARKUS_VAULT_TLS_CA_CERT: "/etc/xroad/ssl/openbao.crt"
{% if (messagelog_archiver_clean_keep_records_for | default('')) | length > 0 %}
    XROAD_MESSAGE_LOG_ARCHIVER_CLEAN_KEEP_RECORDS_FOR: "{{ messagelog_archiver_clean_keep_records_for }}"
{% endif %}

{% if jvm_metrics_enabled %}
jvmMetrics:
  enabled: true
{% endif %}

{% if otel_enabled | default(false) | bool %}
otel:
  enabled: true
  nodeId: "{{ otel_node_id | default('') }}"
  endpoint: {{ otel_endpoint }}
  protocol: "{{ otel_protocol | default('grpc') }}"
  sampler: {{ otel_sampler }}
  resourceAttributes:
    serviceNamespace: xroad
    deploymentEnvironment: {{ otel_deployment_environment }}
{% endif %}

{% if signer_hsm_enabled | default(false) | bool %}
signer:
  hsm:
    enabled: true
{% endif %}

{% set dsp_participant_context_id = dsp_participant_context_id | default('') %}
{% if ds_tls or (dsp_participant_context_id | length > 0) %}
dsp:
{% if ds_tls %}
  seed:
    trustedIssuerDid: "did:web:{{ trusted_issuer_host | default('xrd-cs') }}%3A6183:issuer"
{% endif %}
{% if dsp_participant_context_id | length > 0 %}
  participantContextId: "{{ dsp_participant_context_id }}"
{% endif %}
{% endif %}

# Postgres image used by DSP wait-gate initContainers. The DB clusters
# themselves are provisioned by the cloudnative_pg role, not the chart.
postgres:
  image: "{{ postgres_image }}"
