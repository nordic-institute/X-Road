# Template for .env file used by docker-compose
# Copy this to .env and customize for your environment
#
# For local development, use localhost:5555 (requires local registry)
# For CI, this file is auto-generated with GHCR URLs

# Secret store token for OpenBao (root token for dev mode)
XROAD_SECRET_STORE_ROOT_TOKEN=root-token
XROAD_SECRET_STORE_TOKEN=xroad-dev-client-token

# Development images
OPENBAO_DEV_IMG=localhost:5555/openbao-dev:7.8.0-SNAPSHOT
POSTGRES_DEV_IMG=localhost:5555/postgres-dev:7.8.0-SNAPSHOT

# Configuration Proxy component images
CONFIGURATION_PROXY_IMG=localhost:5555/configuration-proxy:7.8.0-SNAPSHOT
CONFPROXY_DB_INIT_IMG=localhost:5555/configuration-proxy-db-init:7.8.0-SNAPSHOT
SIGNER_IMG=localhost:5555/ss-signer:7.8.0-SNAPSHOT
NGINX_CP_IMG=localhost:5555/nginx-cp:7.8.0-SNAPSHOT
