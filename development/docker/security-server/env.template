# Template for .env file used by docker-compose
# Copy this to .env and customize for your environment
#
# For local development, use localhost:5555 (requires local registry)
# For CI, this file is auto-generated with GHCR URLs
#
# IMAGE_TAG below must match the tag produced by build-images.sh.
# The tag is derived from src/gradle.properties:
#   xroadVersion + "-" + xroadBuildType  (e.g. 8.0.0-beta2-SNAPSHOT for a SNAPSHOT build)
#   or xroadVersion alone for RELEASE builds.
# Update this value whenever the project version in gradle.properties changes.

# Secret store token for OpenBao (root token for dev mode)
XROAD_SECRET_STORE_ROOT_TOKEN=root-token
XROAD_SECRET_STORE_TOKEN=xroad-dev-client-token

# Security Server component images
# Format: REGISTRY/image-name:tag
DB_INIT_IMG=localhost:5555/ss-db-init:8.0.0-beta2-SNAPSHOT
CONFIGURATION_CLIENT_IMG=localhost:5555/ss-configuration-client:8.0.0-beta2-SNAPSHOT
MONITOR_IMG=localhost:5555/ss-monitor:8.0.0-beta2-SNAPSHOT
SIGNER_IMG=localhost:5555/ss-signer:8.0.0-beta2-SNAPSHOT
SOFTTOKEN_SIGNER_IMG=localhost:5555/ss-softtoken-signer:8.0.0-beta2-SNAPSHOT
PROXY_IMG=localhost:5555/ss-proxy:8.0.0-beta2-SNAPSHOT
PROXY_UI_IMG=localhost:5555/ss-proxy-ui-api:8.0.0-beta2-SNAPSHOT
AUXILIARY_SERVICE_IMG=localhost:5555/ss-auxiliary-service:8.0.0-beta2-SNAPSHOT
OP_MONITOR_IMG=localhost:5555/ss-op-monitor:8.0.0-beta2-SNAPSHOT
DS_CONTROL_PLANE_IMG=localhost:5555/ds-control-plane:8.0.0-beta2-SNAPSHOT
DS_IDENTITY_HUB_IMG=localhost:5555/ds-identity-hub:8.0.0-beta2-SNAPSHOT
DS_ISSUER_SERVICE_IMG=localhost:5555/ds-issuer-service:8.0.0-beta2-SNAPSHOT
