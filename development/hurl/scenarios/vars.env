cs_host=cs
ca_host=testca
ss0_host=ss0
ss1_host=ss1
ss0_proxy=localhost
ss1_proxy=localhost

example_service_wsdl=http://issoap:8080/example-adapter/Endpoint?wsdl
example_service_address=http://issoap:8080/example-adapter/Endpoint

is_rest_url=http://isrest:8080/integration/mock_1
is_rest_service_code=mock1

is_openapi_url=http://isopenapi:8080/v3/api-docs
is_openapi_service_code=restapi

is_rest_payloadgen_url=http://payloadgen:8080
is_rest_payloadgen_service_code=payloadgen

# --- Dataspace (DSP) issuer service ---
# Issuer Service (ds-issuer-service): co-located with CS in LXD (xrd-cs).
# In docker compose env: hostname `ds-issuer-service`.
# The issuer participant context is provisioned by CS init over X-Road gRPC;
# these are used by setup.hurl to gate on the published issuer DID document.
is_host=ds-issuer-service
is_did_port=6183

# --- DS TLS certificate provisioning ---
# setup.hurl provisions each server's DS TLS certificate through the admin API
# (key -> DN-only CSR -> test-CA signing -> upload). The CA attaches the SAN list
# passed in the sign request's `san` field, so every hostname a peer dials a ds-*
# service on must appear here. Defaults fit the compose e2e topology; LXD and k8s
# override per host (their own vars.env / hurl.vars).
ds_tls_ca_file=ca/ca.pem
cs_ds_tls_dn=CN=cs
cs_ds_tls_san=DNS:cs,DNS:ds-issuer-service,DNS:localhost
ss0_ds_tls_dn=CN=xrd-ss0
ss0_ds_tls_san=DNS:ds-identity-hub,DNS:ds-control-plane,DNS:ss0-ds-identity-hub,DNS:ss0-ds-control-plane,DNS:xrd-ss0,DNS:localhost
ss1_ds_tls_dn=CN=xrd-ss1
ss1_ds_tls_san=DNS:ds-identity-hub,DNS:ds-control-plane,DNS:ss1-ds-identity-hub,DNS:ss1-ds-control-plane,DNS:xrd-ss1,DNS:localhost
