cs_host=cs
ca_host=testca
ss0_host=ss0
ss1_host=ss1
ss0_proxy=localhost
ss1_proxy=localhost

example_service_wsdl=http://issoap:8080/example-adapter/Endpoint?wsdl
example_service_address=http://issoap:8080/example-adapter/Endpoint

is_rest_url=http://isrest:8080/integration/mock_1
is_rest_service_code=mock1

is_openapi_url=http://isopenapi:8080/v3/api-docs
is_openapi_service_code=restapi

is_rest_payloadgen_url=http://payloadgen:8080
is_rest_payloadgen_service_code=payloadgen

# --- Dataspace (DSP) issuer service ---
# Issuer Service (ds-issuer-service): co-located with CS in LXD (xrd-cs).
# In docker compose env: hostname `ds-issuer-service`.
# The issuer participant context is provisioned by CS init over X-Road gRPC;
# these are used by setup.hurl to gate on the published issuer DID document.
is_host=ds-issuer-service
is_did_port=6183

# --- DS TLS certificate provisioning (admin API manual CSR flow) ---
# Trust anchor registered in approvedDsTlsCa: the test CA root, downloaded into the
# file-root's ca/ directory by every environment's hurl runner — the same CA that
# signs the DS TLS leaves below. Environments may override the path.
ds_tls_ca_file=ca/ca.pem
# DN and subjectAltName list per server for the test-CA-signed DS TLS leaf. The DN
# CN is the server's DS public hostname; the SAN list must cover every hostname the
# server's ds-* endpoints are dialed on (Jetty SNI checks and client hostname
# verification both resolve against it). Environments override these alongside the
# host variables above.
cs_ds_tls_dn=CN=cs
cs_ds_tls_san=DNS:cs,DNS:ds-issuer-service,DNS:localhost
ss0_ds_tls_dn=CN=ss0
ss0_ds_tls_san=DNS:ds-control-plane,DNS:ds-identity-hub,DNS:localhost
ss1_ds_tls_dn=CN=ss1
ss1_ds_tls_san=DNS:ds-control-plane,DNS:ds-identity-hub,DNS:localhost
