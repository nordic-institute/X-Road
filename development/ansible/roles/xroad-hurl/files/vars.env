cs_host=xrd-cs
ca_host=xrd-ca
ss0_host=xrd-ss0
ss1_host=xrd-ss1
ss0_proxy=xrd-ss0
ss1_proxy=xrd-ss1

# X-Road encoded ClientId (INSTANCE:CLASS:CODE) for each SS owner, used by
# 00-setup-dsp.hurl when seeding the MembershipCredential's xrdMemberIdentifier
# claim. Reads via {{ss0_member_id}} / {{ss1_member_id}} in the scenario.
ss0_member_id=DEV:COM:1234
ss1_member_id=DEV:COM:4321

example_service_wsdl=http://xrd-is:8080/example-adapter/Endpoint?wsdl
example_service_address=http://xrd-is:8080/example-adapter/Endpoint

is_rest_url=http://xrd-is/integration/mock_1
is_rest_service_code=mock1

is_openapi_url=http://xrd-is:8081/v3/api-docs
is_openapi_service_code=restapi

# --- Dataspace (DSP) hosts + ports ---
# Issuer Service runs on the CS host in LXD (see roles/xroad-cs/tasks/main.yml).
is_host=xrd-cs
is_id_port=6182
is_did_port=6183
is_iss_port=6185
is_admin_port=6186

# Identity Hub runs on each SS host.
ih_id_port=7182
ih_did_port=7183
ih_sts_port=7184
ih_cred_port=7185

# Control Plane runs on each SS host.
ds_cp_mgmt_port=8182
ds_cp_proto_port=8183

