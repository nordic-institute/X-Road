cs_host=xrd-cs.lxd
ca_host=xrd-ca.lxd
ss0_host=xrd-ss0.lxd
ss1_host=xrd-ss1.lxd
ss0_proxy=xrd-ss0.lxd
ss1_proxy=xrd-ss1.lxd

ss0_ih_host=xrd-ss0.lxd
ss1_ih_host=xrd-ss1.lxd
ss0_cp_host=xrd-ss0.lxd
ss1_cp_host=xrd-ss1.lxd
ss0_participant_id=xrd-ss0.lxd
ss1_participant_id=xrd-ss1.lxd

# --- X-Road instance and members ---
# setup.hurl, test-proxy-*.hurl and perftest-ss0.hurl derive every instance/member identifier
# from these values. ss0 hosts the management member, ss1 the second (client) member.
# ss1_sign_token_type selects the token that holds ss1's sign key by type.
xroad_instance=DEV
member_class=COM
ss0_member_code=1234
ss1_member_code=4321
ss1_sign_token_type=HARDWARE

example_service_wsdl=http://xrd-is.lxd:8080/example-adapter/Endpoint?wsdl
example_service_address=http://xrd-is.lxd:8080/example-adapter/Endpoint

is_rest_url=http://xrd-is.lxd/integration/mock_1
is_rest_service_code=mock1

is_openapi_url=http://xrd-is.lxd:8081/v3/api-docs
is_openapi_service_code=restapi

# --- Dataspace (DSP) hosts + ports ---
# Issuer Service runs on the CS host in LXD (see roles/xroad-cs/tasks/main.yml).
is_host=xrd-cs
is_did_port=6183
is_iss_port=6185

# The env-wide xrd-ca test CA signs every host's DS TLS certificate; its root is ca/ca.pem,
# which run-hurl.sh.j2 already downloads from http://<ca_host>:8888/testca/certs. Register
# that same file as the DS TLS CA trust anchor.
ds_tls_ca_file=ca/ca.pem

# Per-host DS TLS certificate DN + SAN, consumed by setup.hurl's admin-API provisioning
# blocks (key -> CSR -> xrd-ca signing -> upload). The SAN list must cover every name a
# peer dials the host's ds-* services on: bare hostname (issuer DID host is bare xrd-cs),
# the .lxd form used by DSP/STS URLs, and localhost for self-connects.
cs_ds_tls_dn=CN=xrd-cs
cs_ds_tls_san=DNS:xrd-cs,DNS:xrd-cs.lxd,DNS:localhost
ss0_ds_tls_dn=CN=xrd-ss0
ss0_ds_tls_san=DNS:xrd-ss0,DNS:xrd-ss0.lxd,DNS:localhost
ss1_ds_tls_dn=CN=xrd-ss1
ss1_ds_tls_san=DNS:xrd-ss1,DNS:xrd-ss1.lxd,DNS:localhost

# Identity Hub runs on each SS host.
ih_did_port=7183
ih_sts_port=7184
ih_cred_port=7185

# Control Plane runs on each SS host.
ds_cp_mgmt_port=8182
ds_cp_proto_port=8183

