---
quarkus:
  log:
    level: INFO
    category:
      "org.niis.xroad":
        level: DEBUG
      "io.quarkus":
        level: INFO

xroad:
  common-global-conf:
    source: REMOTE
  proxy-ui-api:
    acme-challenge-port-enabled: true
    dataspace:
      identity-hub-url: https://{{ inventory_hostname }}.lxd:7182
      participant-id: {{ inventory_hostname }}.lxd
      issuer-did: did:web:xrd-cs%3A6183:issuer # issuer host hardcoded to lxd dev env host (cs_servers has exactly one host)
  dataspace:
    # IdentityHub and Control Plane run locally on this SS. Both provisioning gRPC
    # channels default to the docker compose service names (ds-identity-hub /
    # ds-control-plane), which don't resolve on LXD — point them at the local host,
    # like every other internal RPC channel (signer/proxy/monitor use 127.0.0.1).
    identity-hub-provisioning:
      rpc:
        host: 127.0.0.1
    control-plane-provisioning:
      rpc:
        host: 127.0.0.1

  acme: |
    eab-credentials:
      certificate-authorities:
        'Test CA':
          mac-key-base64-encoded: true
          members:
            'DEV:COM:1234':
              #kid: keyid_1
              #mac-key: 78a6d08bb1d1b91ab116790e1ab59517352fa5e0c8ac360c3a80255d80de2259
              auth-kid: keyid_2
              auth-mac-key: addfdbb19965e85623c124a88d085eae50a7f7f4f570989e3a320a81c3119625
              sign-kid: keyid_3
              sign-mac-key: 96d7380f5ea8de06912a4520d0adca616848b5e70cb3d0bd748af5b33507ddde
    account-keystore-password: testPassword1234

  mail-notification: |-
    host: xrd-cs # This is hardcoded to lxd dev env host.
    port: 1025
    username: testusername
    password: testpassword
    contacts:
      'DEV:COM:1234': member1@example.org
